# ==============================================================================
# EdgePilot: Delta Exchange India Testnet Trading Bot Environment Configuration
# ==============================================================================
# IMPORTANT: Never commit actual keys or production credentials to Git.
# Copy this file to .env and fill in your dedicated Delta Testnet API credentials.

# ------------------------------------------------------------------------------
# Environment & Exchange Host Policy (Fail-Closed: Only TESTNET allowed in v1)
# ------------------------------------------------------------------------------
ENVIRONMENT=TESTNET
DELTA_REST_URL=https://cdn-ind.testnet.deltaex.org
DELTA_WS_URL=wss://socket-ind.testnet.deltaex.org

# ------------------------------------------------------------------------------
# Delta Exchange India Testnet API Credentials (Keep secret! Redacted in logs)
# ------------------------------------------------------------------------------
DELTA_API_KEY=your_testnet_api_key_here
DELTA_API_SECRET=your_testnet_api_secret_here

# ------------------------------------------------------------------------------
# Market & Strategy Settings
# ------------------------------------------------------------------------------
SYMBOL=BTCUSD
PRODUCT_ID=84
TREND_TIMEFRAME=15m
ENTRY_TIMEFRAME=5m

# Indicators Baseline
EMA_FAST=20
EMA_TREND_FAST=50
EMA_TREND_SLOW=200
RSI_PERIOD=14
RSI_LONG_THRESHOLD=40.0
RSI_SHORT_THRESHOLD=60.0
ADX_PERIOD=14
ADX_THRESHOLD=20.0

# ------------------------------------------------------------------------------
# Risk Controls (Enforced server-side before every order)
# ------------------------------------------------------------------------------
TEST_EQUITY_USD=10000.00
RISK_PER_TRADE_PCT=0.0025
DAILY_LOSS_LIMIT_PCT=0.015
MAX_OPEN_POSITIONS=1
MAX_SPREAD_TICKS=10
COOLDOWN_SECONDS=300
SLIPPAGE_TOLERANCE_PCT=0.001

# ------------------------------------------------------------------------------
# Runtime & Security
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///trading_bot.db
LOG_LEVEL=INFO
